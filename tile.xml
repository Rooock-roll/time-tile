<?xml version="1.0"?>
<tile>
  <visual branding="logo">
    <binding template="TileMedium">
      <image src="https://cdn.jsdelivr.net/gh/Rooock-roll/time-tile@main/img/art-1.jpg" placement="background" hint-crop="none"/>
      <text hint-style="base" hint-wrap="true">How to Keep an Open Mind</text>
    </binding>
    <binding template="TileWide">
      <image src="https://cdn.jsdelivr.net/gh/Rooock-roll/time-tile@main/img/art-1.jpg" placement="background" hint-crop="none"/>
      <text hint-style="base" hint-wrap="true">How to Keep an Open Mind</text>
    </binding>
    <binding template="TileLarge">
      <image src="https://cdn.jsdelivr.net/gh/Rooock-roll/time-tile@main/img/art-1.jpg" placement="background" hint-crop="none"/>
      <text hint-style="subtitle" hint-wrap="true">How to Keep an Open Mind</text>
    </binding>
    <binding template="TileSmall">
      <text hint-style="caption">How to Keep an Open Mind</text>
    </binding>
  </visual>
</tile>
