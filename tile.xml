<?xml version="1.0"?>
<tile>
  <visual branding="logo">
    <binding template="TileMedium">
      <image src="https://fastly.jsdelivr.net/gh/Rooock-roll/time-tile@074e4a2ec322496c115943cf28c6d8c6328fc434/img/art-4.jpg" placement="background" hint-crop="none"/>
      <text hint-style="base" hint-maxlines="2" hint-wrap="true">John Harris</text>
    </binding>
    <binding template="TileWide">
      <image src="https://fastly.jsdelivr.net/gh/Rooock-roll/time-tile@074e4a2ec322496c115943cf28c6d8c6328fc434/img/art-4.jpg" placement="background" hint-crop="none"/>
      <text hint-style="caption" hint-maxlines="2" hint-wrap="true">John Harris</text>
    </binding>
    <binding template="TileLarge">
      <image src="https://fastly.jsdelivr.net/gh/Rooock-roll/time-tile@074e4a2ec322496c115943cf28c6d8c6328fc434/img/art-4.jpg" placement="background" hint-crop="none"/>
      <text hint-style="subtitle" hint-maxlines="3" hint-wrap="true">John Harris</text>
    </binding>
    <binding template="TileSmall">
      <text hint-style="caption">John Harris</text>
    </binding>
  </visual>
</tile>
