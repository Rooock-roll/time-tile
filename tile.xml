<?xml version="1.0"?>
<tile>
  <visual branding="logo">
    <binding template="TileMedium">
      <image src="https://fastly.jsdelivr.net/gh/Rooock-roll/time-tile@9810c5bc38f97ee2c42457d41e98ab9b4d86411b/img/art-3.jpg" placement="background" hint-crop="none"/>
      <text hint-style="base" hint-maxlines="2" hint-wrap="true">Xavier Laguarta Soler</text>
    </binding>
    <binding template="TileWide">
      <image src="https://fastly.jsdelivr.net/gh/Rooock-roll/time-tile@9810c5bc38f97ee2c42457d41e98ab9b4d86411b/img/art-3.jpg" placement="background" hint-crop="none"/>
      <text hint-style="caption" hint-maxlines="2" hint-wrap="true">Xavier Laguarta Soler</text>
    </binding>
    <binding template="TileLarge">
      <image src="https://fastly.jsdelivr.net/gh/Rooock-roll/time-tile@9810c5bc38f97ee2c42457d41e98ab9b4d86411b/img/art-3.jpg" placement="background" hint-crop="none"/>
      <text hint-style="subtitle" hint-maxlines="3" hint-wrap="true">Xavier Laguarta Soler</text>
    </binding>
    <binding template="TileSmall">
      <text hint-style="caption">Xavier Laguarta Soler</text>
    </binding>
  </visual>
</tile>
