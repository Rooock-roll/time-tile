<?xml version="1.0"?>
<tile>
  <visual branding="logo">
    <binding template="TileMedium">
      <image src="https://fastly.jsdelivr.net/gh/Rooock-roll/time-tile@f8b851fe23765f8986fedc6ace52e27b1191fc0a/img/art-4.jpg" placement="background" hint-crop="none"/>
      <text hint-style="base" hint-maxlines="2" hint-wrap="true">Waiting on a Friend</text>
    </binding>
    <binding template="TileWide">
      <image src="https://fastly.jsdelivr.net/gh/Rooock-roll/time-tile@f8b851fe23765f8986fedc6ace52e27b1191fc0a/img/art-4.jpg" placement="background" hint-crop="none"/>
      <text hint-style="caption" hint-maxlines="2" hint-wrap="true">Waiting on a Friend</text>
    </binding>
    <binding template="TileLarge">
      <image src="https://fastly.jsdelivr.net/gh/Rooock-roll/time-tile@f8b851fe23765f8986fedc6ace52e27b1191fc0a/img/art-4.jpg" placement="background" hint-crop="none"/>
      <text hint-style="subtitle" hint-maxlines="3" hint-wrap="true">Waiting on a Friend</text>
    </binding>
    <binding template="TileSmall">
      <text hint-style="caption">Waiting on a Friend</text>
    </binding>
  </visual>
</tile>
