<?xml version="1.0"?>
<tile>
  <visual branding="logo">
    <binding template="TileMedium">
      <image src="https://fastly.jsdelivr.net/gh/Rooock-roll/time-tile@4aea19dd6685861c3bc59bcb1969d90285b02eb6/img/art-3.jpg" placement="background" hint-crop="none"/>
      <text hint-style="base" hint-maxlines="2" hint-wrap="true">Whistler</text>
    </binding>
    <binding template="TileWide">
      <image src="https://fastly.jsdelivr.net/gh/Rooock-roll/time-tile@4aea19dd6685861c3bc59bcb1969d90285b02eb6/img/art-3.jpg" placement="background" hint-crop="none"/>
      <text hint-style="caption" hint-maxlines="2" hint-wrap="true">Whistler</text>
    </binding>
    <binding template="TileLarge">
      <image src="https://fastly.jsdelivr.net/gh/Rooock-roll/time-tile@4aea19dd6685861c3bc59bcb1969d90285b02eb6/img/art-3.jpg" placement="background" hint-crop="none"/>
      <text hint-style="subtitle" hint-maxlines="3" hint-wrap="true">Whistler</text>
    </binding>
    <binding template="TileSmall">
      <text hint-style="caption">Whistler</text>
    </binding>
  </visual>
</tile>
