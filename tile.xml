<?xml version="1.0"?>
<tile>
  <visual branding="logo">
    <binding template="TileMedium">
      <image src="https://fastly.jsdelivr.net/gh/Rooock-roll/time-tile@7cfe09f79be638773856f3339cc5b7846244c8f4/img/art-1.jpg" placement="background" hint-crop="none"/>
      <text hint-style="base" hint-maxlines="2" hint-wrap="true">No One Should Be Shamed for Using a Mobility Aid</text>
    </binding>
    <binding template="TileWide">
      <image src="https://fastly.jsdelivr.net/gh/Rooock-roll/time-tile@7cfe09f79be638773856f3339cc5b7846244c8f4/img/art-1.jpg" placement="background" hint-crop="none"/>
      <text hint-style="caption" hint-maxlines="2" hint-wrap="true">No One Should Be Shamed for Using a Mobility Aid</text>
      <text hint-style="captionSubtle" hint-maxlines="4" hint-wrap="true">People with disabilities deserve the basic dignity of using the tools that support our bodies without fear of being judged or harassed, writes Nicole Clark.</text>
    </binding>
    <binding template="TileLarge">
      <image src="https://fastly.jsdelivr.net/gh/Rooock-roll/time-tile@7cfe09f79be638773856f3339cc5b7846244c8f4/img/art-1.jpg" placement="background" hint-crop="none"/>
      <text hint-style="subtitle" hint-maxlines="3" hint-wrap="true">No One Should Be Shamed for Using a Mobility Aid</text>
      <text hint-style="captionSubtle" hint-maxlines="8" hint-wrap="true">People with disabilities deserve the basic dignity of using the tools that support our bodies without fear of being judged or harassed, writes Nicole Clark.</text>
    </binding>
    <binding template="TileSmall">
      <text hint-style="caption">No One Should Be Shamed…</text>
    </binding>
  </visual>
</tile>
